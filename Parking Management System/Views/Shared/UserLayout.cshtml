@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Parking_Management_System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/datatable/datatables.css" rel="stylesheet" />
    <link href="~/css/datatable/datatables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link href="~/css/index.css" rel="stylesheet" />

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar bg-light">
            <div class="container-fluid">
                <a class="navbar-brand" style="color:black" asp-controller="Home" asp-action="Index">SmartPark Management System</a>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" aria-current="page" asp-controller="Home" asp-action="Index">HOME</a>
                        </li>

                        
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {

                            <li class="nav-item">
                                <span class="nav-link text-primary">Welcome, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center " onclick="logout();"
                                   asp-controller="ToAuthentication" asp-action="LogOut">
                                    <i class="bi bi-box-arrow-right me-2">	</i> Log Out
                                </a>
                            </li>
                        }
                    </ul>

                    
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar">
                <div class="sidebar-sticky pt-3">
                    <ul class="nav flex-column">

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center @(currentAction == "Dashboard"  ? "active" : "")"
                               asp-controller="ToUser"
                               asp-action="DashBoard">
                                <i class="bi bi-speedometer2 me-2"></i> User Dashboard 
                            </a>
                        </li>

                     
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center @(currentAction == "BookParkingSlot" && currentController == "ToUser" ? "active" : "")"
                               asp-controller="ToUser"
                               asp-action="BookParkingSlot">
                                <i class="bi bi-journal-check me-2"></i> Book Slot
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center @(currentAction == "CurrentBooking" && currentController == "ToUser" ? "active" : "")"
                               asp-controller="ToUser"
                               asp-action="CurrentBooking">
                                <i class="bi bi-people me-2"></i> Current Booking
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center @(currentAction == "UpcomingBooking" && currentController == "ToUser" ? "active" : "")"
                               asp-controller="ToUser"
                               asp-action="UpcomingBooking" onclick="UpcomingBooking();">
                                <i class="bi bi-people me-2"></i> Upcoming Booking
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center @(currentAction == "BookingHistory" && currentController == "ToUser" ? "active" : "")"
                               asp-controller="ToUser"
                               asp-action="BookingHistory">
                                <i class="bi bi-clock-history me-2"></i> Booking History
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center " onclick="logout();"
                               asp-controller="ToAuthentication" asp-action="LogOut">
                                <i class="bi bi-box-arrow-right me-2">	</i> Log Out
                            </a>
                        </li>

                    </ul>
                </div>
            </nav>
            <div>
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
           
        </div>
    </main>
    
   
    <footer class="text-white" id="footerid">
        <div class="container text-center">
            SmartPark Management System ©2025
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/datatable/datatables.js"></script>
    <script src="~/datatable/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function logout() {
            sessionStorage.clear();
            console.log('sessionStorage after clear:', sessionStorage);
            window.location.href = '/ToAuthentication/LogOut';
        }
    </script>
</body>
</html>


