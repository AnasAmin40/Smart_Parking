	<script>
		function logout() {
			sessionStorage.clear(); // ✅ Clear frontend session data
			console.log('sessionStorage after clear:', sessionStorage);
			window.location.href = '/ToAuthentication/LogOut'; // ✅ Triggers backend logout
		}
