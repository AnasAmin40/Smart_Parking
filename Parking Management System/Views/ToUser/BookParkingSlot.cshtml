
﻿@{
	Layout = "~/Views/Shared/UserLayout.cshtml";
}
<main>
	<div class="container-fluid">
		<div class="row">
			

			<main class="col-md-10 ms-sm-auto px-md-4 tab-content pt-3">

				<div class="tab-pane fade show active" id="book-slot" role="tabpanel">
					<h3>Book Parking Slot</h3>
					<form class="row g-3">
						<div class="col-md-4">

							<label class="form-label">Start Time</label>
							<input id="StartTime" type="datetime-local" class="form-control" />
						</div>

						<div class="col-md-4">
							<label class="form-label">Duration (hours)</label>
							<input id="hours" type="number" class="form-control" min="1" max="12" value="1" />
						</div>

						<div class="col-md-4">
							<label class="form-label">Select Location</label>
							<select id="LocationDropdown" class="form-select">
								<option selected disabled>Select Location</option>
							</select>
						</div>
						
						<div class="col-md-4">
							<label class="form-label">Slot Type</label>
							<select id="SlotTypeDropdown" class="form-select" disabled>
								<option selected disabled>Slot Type</option>
								<option value="Car">Car</option>
								<option value="Bike">Bike</option>
								<option value="Bus">Bus</option>
								<option value="VIP_Car">VIP_Car</option>
							</select>
						</div>

						<div class="col-md-4">
							

							@* <span><i class="fas fa-user-shield" title="Administrator"></i> Administrator</span> &nbsp;&nbsp;
							<span><i class="fas fa-user-tie" title="Manager"></i> Manager</span> &nbsp;&nbsp;
							<span><i class="fas fa-user" title="User"></i> User</span> *@

							<label class="form-label">Select Slot</label>

							<select id="AvailableSlotDropdown" class="form-select" disabled>
								<option  selected disabled>Select Slot</option>
							</select>
						</div>
						

						

						
						<div class="col-md-12">
							<button id="BookSlotId" type="submit" onclick="BookingSlot(event)" class="btn btn-success" disabled>Book Slot</button>

						</div>
					</form>
				 
			 </div>


			</main>
		</div>
	</div>


</main>


@section Scripts {
	<script src="/js/bookingslots.js"></script>
}

