
﻿@{
	Layout = "~/Views/Shared/UserLayout.cshtml";
}
<style>
	.booking-card {
		border: 2px solid green;
		border-radius: 12px;
		padding: 20px;
		max-width: 450px;
		margin: 30px auto;
		background-color: #f8f9fa;
		box-shadow: 0 0 12px rgba(0, 128, 0, 0.1);
	}

		.booking-card h5 {
			color: green;
		}

</style>
<main>

	<div class="container-fluid">
		<div class="row">
		
			<div class="col-md-10 ms-sm-auto px-md-4 tab-content pt-3">

					<h3>Current Booking Status</h3>
				<div id="activeBookingsContainer" class="row">
					
					</div>
			</div>
		</div>
	</div>
</main>

@section Scripts{
	<script src="/js/bookings.js"></script>
}


