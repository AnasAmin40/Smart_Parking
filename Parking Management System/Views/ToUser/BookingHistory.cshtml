
﻿@{
	Layout = "~/Views/Shared/UserLayout.cshtml";
}
<main>
	<div class="container-fluid">
		<div class="row">

			<main class="col-md-10 ms-sm-auto px-md-4 tab-content pt-3">

				<div class="tab-pane fade active show"
					 id="booking-history"
					 role="tabpanel"
					 aria-labelledby="booking-history-tab">
					<h3>Booking History</h3>
					<table id="BookingHistoryTable" class="table table-striped">
						<thead>
							<tr>
								<th>BookingId</th>
								<th>LocationName</th>
								<th>SlotNumber</th>
								<th>SlotType</th>
								<th>StartTime</th>
								<th>ExitTime</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
