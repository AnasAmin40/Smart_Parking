@{
	Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<main>
	<div class="container-fluid">
		<div class="row">
			<main class="col-md-10 ms-sm-auto px-md-4">
				@* <h2 class="mt-4">Manage Users</h2> *@
				<div style="background-color:none; min-height: 450px; border-color:#fff" class="card shadow-sm rounded mb-4 bg-light mt-3">
					<div class="card-header d-flex justify-content-between align-items-center">
						<h2 class="mb-0 fw-bold text-primary">Manage Users</h2>
						<button class="btn btn-success btn-sm d-flex align-items-center" id="AddUserBtn">
							<i class="bi bi-plus-lg me-1"></i> Add Users
						</button>
					</div>
					<div class="card-body">

						<table id="userTable" class="table table-striped table-hover align-middle">
							<thead>
								<tr>
									<th>User ID</th>
									<th>Name</th>
									<th>Email</th>
									<th>Mobile</th>
									<th>Role</th>
									<th>Status</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody id="userBody"></tbody>
						</table>

					</div>
				</div>


				<div class="modal fade model" id="UserModal">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h1 class="text-info modal-title" id="ModalHeading">Add User</h1>
								<button class="btn-close text-danger" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>

							<div class="modal-body">
								<form method="post">
									<div class="form-group " id="UserIdDiv">
										@* <label>UserId</label> *@
										<input type="text" class="form-control" id="UserId" disabled="disabled" hidden />
										<input type="hidden" id="UserIdHidden" value="123" />

									</div>
									<div class="form-group">
										<label>Name</label>
										<input placeholder="Enter Name" type="text" class="form-control" id="UserName" autocomplete="off" />
									</div>

									<div class="form-group">
										<label>Email</label>
										<input placeholder="Enter Email" type="email" class="form-control" id="UserMail" autocomplete="off" />
									</div>
									<div class="form-group">
										<label>Mobile</label>
										<input placeholder="Enter Mobile Number" type="number" class="form-control" id="Mobile" autocomplete="off" />
									</div>
									<div class="form-group" id="passwordinput">
										<label>Password</label>
										<input placeholder="Enter Password" type="password" class="form-control" id="Password" autocomplete="off" />
									</div>
									<div class="form-group" id="Confirmpasswordinput">
										<label>Confirm Password</label>
										<input placeholder="Enter Confirm Password" type="password" class="form-control" id="ConfirmPassword" autocomplete="off" />
									</div>
									
									<div class="form-group form-check mt-2">
										<label typeof="checkbox" class="form-check-label">Active</label>
										<input type="checkbox" class="form-check-input" id="active" />
									</div>
									<div class="form-group">
										<label for="roles">Role</label>
										<select id="roles" class="form-control"></select>
									</div>
									

								</form>
							</div>
							<div class="modal-footer">
								<button class="btn btn-success" onclick="AddUser();" id="AddUser">Save</button>
								<button class="btn btn-warning" onclick="UpdateUser();" style="display:none" id="UpdateUser">Update</button>
								<button class="btn btn-danger btn-default" data-bs-dismiss="modal" onclick="CloseModal();">Close</button>
							</div>
						</div>
					</div>
				</div>


			</main>
		</div>
	</div>
</main>

@section scripts {
	<script src="/js/usermangement.js"></script>
	@* <script src="/js/test.js"></script> *@
}
















