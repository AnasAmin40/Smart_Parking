@{
	ViewData["Title"] = "Index";

	Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<main>
	<div class="container-fluid">
		<div class="row">
			<main class="col-md-10 ms-sm-auto px-md-4">
				@* <h2 class="mt-4">Manage Role</h2> *@
				<div style="background-color:none; min-height: 450px; border-color:#fff" class="card shadow-sm rounded mb-4 bg-light mt-3">
					<div class="card-header d-flex justify-content-between align-items-center">
						<h2 class="mb-0 fw-bold text-primary">Manage Role</h2>
						<button class="btn btn-success btn-sm d-flex align-items-center" id="AddRoleBtn">
							<i class="bi bi-plus-lg me-1"></i> Add Role
						</button>
					</div>
					<div class="card-body">
						
						<table id="UserTable" class="table table-striped table-hover align-middle">
							<thead>
								<tr>
									<th>Role ID</th>
									<th>Roles</th>
									<th>Active</th>
									<th>CreatedTime</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody id="RoleBody"></tbody>
						</table>


					</div>
				</div>



				<div class="modal fade model" id="RoleModal">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h1 class="text-info modal-title" id="ModalHeading">Add Role</h1>
								<button class="btn-close text-danger" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>

							<div class="modal-body">
								<form method="post">
									<div class="form-group " id="roleIdBox">
										<label>RoleID</label>
										<input type="text" class="form-control" id="roleId" disabled="disabled" hidden />
										<input type="hidden" id="roleIdHidden" value="123" />

									</div>
									<div class="form-group">
										<label>Role</label>
										<input placeholder="Enter Role" type="text" class="form-control" id="roles" autocomplete="off" />
									</div>
									<div class="form-group form-check mt-2">
										<label typeof="checkbox" class="form-check-label">Active</label>
										<input type="checkbox" class="form-check-input" id="active" />
									</div>
									<div class="form-group mb-3">
										<label>Created Time</label>
										<input type="datetime-local" class="form-control" id="createdTime" />
									</div>

								</form>
							</div>
							<div class="modal-footer">
								<button class="btn btn-success" onclick="AddRole();" id="AddRole">Save</button>
								<button class="btn btn-warning" onclick="UpdateRole();" style="display:none" id="UpdateRole">Update</button>
								<button class="btn btn-danger btn-default" data-bs-dismiss="modal" onclick="CloseModal();">Close</button>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
	</div>
</main>

















@section Scripts {
	@* <script src="/js/usermangement.js"></script> *@
	<script src="/js/test.js"></script>
}




