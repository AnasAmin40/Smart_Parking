<main>
    <div class="d-flex flex-column justify-content-center justify-content-center vh-90 gap-3 " style="margin:30px 0 50px 0;">



        <form style="width: 450px; padding: 2%; background-color: white; border-radius: 3%;" class="container border border-success" id="LoginForm" method="post" onsubmit="Login(event);">

            <h3>  SPMS!! Login Your Account</h3>
            <br />

            <div class="mt-3">
                <label class="mb-1" for="">Email Address</label>

                <input type="email" placeholder="Email Address" class="form-control" id="LoginEmail">

                <span class="text-danger"></span>
            </div>
            <div class="mt-3">
                <label class="mb-1" for="">Password</label>

                <input type="password" autocomplete="username" placeholder="Enter Password" class="form-control" id="LoginPassword">

                <span class="text-danger"></span>
            </div>

            <div class="form-check mt-3">
                <label class="form-check-label">
                    <input class="form-check-input" type="checkbox" name="remember"> Remember me
                </label>
            </div>



            <button type="submit" onclick="Login(event);" class="btn btn-primary mt-3 " style="width: 100%; ">SIGN IN</button>

        </form>
        <div class="container border border-success " style="width: 450px;  padding: 1%; background-color: white; border-radius: 5px;">
            <span>Don't have an account? </span><a asp-controller="Home" asp-action="Register" class="text-primary" style="text-decoration: none; font-weight:700 ;">Sign up</a>

        </div>


    </div>



</main>

