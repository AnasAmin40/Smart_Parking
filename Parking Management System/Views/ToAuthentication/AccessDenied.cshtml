<div class="container min-vh-100 d-flex flex-column justify-content-center align-items-center">
    <div class="card p-4 shadow text-center" style="max-width: 420px;">
        <div class="mb-3">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 3rem;"></i>
        </div>
        <h2 class="mb-2 text-danger">Access Denied</h2>
        <p class="mb-4 text-muted">You can't access the Admin page.</p>
        <div class="d-grid gap-2 mb-2">
            <a asp-controller="ToAuthentication" asp-action="LoginPage" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-person-lock"></i> Admin Login
            </a>
        </div>
        <div class="d-grid gap-2">
            <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-lg">
                <i class="bi bi-house-door"></i> Back To Home
            </a>
        </div>
    </div>
</div>

