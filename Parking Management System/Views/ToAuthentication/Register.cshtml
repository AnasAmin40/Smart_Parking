<main>
	<div class="d-flex flex-column justify-content-center align-items-center vh-100  my-4">


		<form style="width: 450px; padding: 2%; background-color: white; border-radius:5px" class="border border-success">
			<h3>  SPMS!! Create Your Account</h3>
			<div class="mt-3">
				<label class="mb-1" for="">Name</label>
				<input type="text" placeholder="Your Name" class="form-control">
				<span class="text-danger"></span>
			</div>
			<div class="mt-3">
				<label class="mb-1" for="">Email Address</label>
				<input type="email" placeholder="Email Address" class="form-control">
				<span class="text-danger"></span>
			</div>
			<div class="mt-3">
				<label class="mb-1" for="">Mobile Nubmer</label>
				<input type="number" placeholder="Mobile Nubmer" class="form-control">
				<span class="text-danger"></span>
			</div>
			
			<div class="mt-3">
				<label class="mb-1" for="">Password</label>
				<input type="password" placeholder="Enter Password" class="form-control">
				<span class="text-danger"></span>
			</div>
			<div class="mt-3">
				<label class="mb-1" for="">Confirm Password</label>
				<input type="password" placeholder="Confirm Password" class="form-control">
				<span class="text-danger"></span>
			</div>
			

			<a class="text-primary float-end mt-3 fw-bold" style="text-decoration: none;" asp-controller="ToAuthentication" asp-action="LoginPage">Login?</a>
			<button class="btn btn-success mt-3" style="width: 100%;">REGISTER</button>
		</form>
	</div>


</main>
