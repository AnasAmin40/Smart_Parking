<div class="container-fluid">
	<div class="row">

		<div class="col-md-10 ms-sm-auto px-md-4">
			<h2 class="mt-4">Admin Dashboard Overview</h2>
			<section class="features-section row text-center mb-5">
				<div class="col-md-3">
					<div class="card p-3 text-center shadow feature-card">
						<div class="feature-icon mb-2 mx-auto">
                            <i class="bi bi-graph-up-arrow fs-1 text-success"></i>
						</div>
                        <div class="feature-value fw-bold display-6" id="Revenue">0</div>
						<div class="feature-label text-muted">
							Today Revenue
						</div>
					</div>
				</div>

				<div class="col-md-3">
					<div class="card p-3 text-center shadow feature-card">
						<div class="feature-icon mb-2 mx-auto">
							<i class="fa-solid fa-car fs-1 text-success"></i>
						</div>
						<div class="feature-value fw-bold display-6" id="CarEntries">0</div>
						<div class="feature-label text-muted">
							Today Cars Entries
						</div>
					</div>
				</div>

				<div class="col-md-3">
					<div class="card p-3 text-center shadow feature-card">
						<div class="feature-icon mb-2 mx-auto">
							<i class="bi bi-bicycle  text-success" style="font-size:40px;"></i>

						</div>
                        <div class="feature-value fw-bold display-6" id="BikeEntries">0</div>
						<div class="feature-label text-muted">Today Bikes Entries</div>
					</div>
				</div>

				<div class="col-md-3">
					<div class="card p-3 text-center shadow feature-card">
						<div class="feature-icon mb-2 mx-auto">
							<!-- <i class="bi bi-car-front-fill fs-1 "></i> -->
							<i class="fa-solid fa-car-side fs-1 text-success"></i>
						</div>
						<div class="feature-value fw-bold display-6" id="ActiveBookings">0</div>
						<div class="feature-label text-muted">Active Bookings</div>
					</div>
				</div>
			</section>


		</div>
	</div>
</div>





@section Scripts {
	<script src="/js/admindashboard.js"></script>
	
}











