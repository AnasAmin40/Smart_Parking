
﻿@{
	Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<main>
	<div class="container-fluid">
		<div class="row">
			<main class="col-md-10 ms-sm-auto px-md-4">

				<div style="background-color:none; min-height: 450px; border-color:#fff" class="card shadow-sm rounded mb-4 bg-light mt-3">
					<div class="card-header d-flex justify-content-between align-items-center">
						<h2 class="mb-0 fw-bold text-primary">Parking Location</h2>
						<button class="btn btn-success btn-sm d-flex align-items-center" id="AddBtn">
							<i class="bi bi-plus-lg me-1"></i> Add Location
						</button>
					</div>
					<div class="card-body">

						<table id="Tableid" class="table table-striped table-hover align-middle">
							<thead>
								<tr>
									<th>ParkingLocationId</th>
									<th>Name</th>
									<th>City</th>
									<th>TotalSlots</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody id="tableBody"></tbody>
						</table>

					</div>
				</div>


				<div class="modal fade model" id="LocationModal">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="text-info modal-title" id="ModalHeading">Add New Location</h3>
								<button class="btn-close text-danger" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>

							<div class="modal-body">
								<form method="post">
									<div class="form-group " id="UserIdDiv">
										@* <label>UserId</label> *@
										<input type="text" class="form-control" id="LocationId" disabled="disabled" hidden />
										<input type="hidden" id="LocationIdHidden" value="123" />

									</div>
									<div class="form-group">
										<label>Name</label>
										<input placeholder="Enter Name" type="text" class="form-control" id="LocationName" autocomplete="off" />
									</div>

									<div class="form-group">
										<label>City</label>
										<input placeholder="Enter City" type="text" class="form-control" id="CityName" autocomplete="off" />
									</div>

									<div class="form-group">
										<label>Total Slots</label>
										<input placeholder="Enter TotalSlots" type="number" class="form-control" id="TotolSlots" autocomplete="off" />
									</div>


								</form>
							</div>
							<div class="modal-footer">
								<button class="btn btn-success" onclick="NewLocation();" id="AddLocationBtn">Save</button>
								<button class="btn btn-warning" onclick="UpdateLocation();" style="display:none" id="UpdateLocationBtn">Update</button>
								<button class="btn btn-danger btn-default" data-bs-dismiss="modal" onclick="CloseModal();">Close</button>
							</div>
						</div>
					</div>
				</div>


			</main>
		</div>
	</div>
</main>

@section scripts {
	<script src="/js/locationmanage.js"></script>
@* <script src="/js/test.js"></script> *@
}




















