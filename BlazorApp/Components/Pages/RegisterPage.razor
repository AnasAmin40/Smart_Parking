@page "/register"
@rendermode InteractiveServer
@inject HttpClient httpClient
@inject IJSRuntime jS

<div class="d-flex flex-column justify-content-center align-items-center vh-100  my-4">


	<form style="width: 450px; padding: 2%; background-color: white; border-radius:5px" class="border border-success" @onsubmit="OnButton">
		<h3>  SPMS!! Create Your Account</h3>
		<div class="mt-3">
			<label class="mb-1" for="">Name</label>
			<input @bind="Name" type="text" id="name" placeholder="Your Name" class="form-control">
			<span class="text-danger"></span>
		</div>
		<div class="mt-3">
			<label class="mb-1" for="">Email Address</label>
			<input @bind="Email" type="email" id="Email" placeholder="Email Address" class="form-control">
			<span class="text-danger"></span>
		</div>
		<div class="mt-3">
			<label class="mb-1" for="">Mobile Nubmer</label>
			<input @bind="Mobile" type="number" id="mobileNumber" placeholder="Mobile Nubmer" class="form-control">
			<span class="text-danger"></span>
		</div>

		<div class="mt-3">
			<label class="mb-1" for="">Password</label>
			<input @bind="Password" type="password" id="password" placeholder="Enter Password" class="form-control">
			<span class="text-danger"></span>
		</div>
		<div class="mt-3">
			<label class="mb-1" for="">Confirm Password</label>
			<input @bind="ConfirmPassword" type="password" id="ConfirmPassword" placeholder="Confirm Password" class="form-control">
			<span class="text-danger"></span>
		</div>


		<a class="text-primary float-end mt-3 fw-bold" style="text-decoration: none;" href="/Login">Login?</a>
		<button type="submit"  class="btn btn-success mt-3" style="width: 100%;">REGISTER</button>
		<span>@status</span>
	</form>
</div>


@code {
	private string Name { get; set; } = string.Empty;
	private string Email { get; set; } = string.Empty;
	private string Mobile { get; set; } = string.Empty;
	private string Password { get; set; } = string.Empty;
	private string ConfirmPassword { get; set; } = string.Empty;


	private string status { get; set; } = "NO";



	public class Users
	{
		public int Id { get; set; }
		public string? Name { get; set; }
		public string? Email { get; set; }
		public string? MobileNumber { get; set; }
		public string? Password { get; set; }
		public string? ConfirmPassword { get; set; }
		public bool Active { get; set; }
		public int RoleId { get; set; }
	}

	private async Task OnButton()
	{
		if (Password != ConfirmPassword)
		{
			await jS.InvokeVoidAsync("alert", "Password is not matched!");
			return;
		}

		if (Name == "" || Email == "" || Mobile == "" || Password == "" || ConfirmPassword == "")
		{
			await jS.InvokeVoidAsync("alert", "Input All fields!");
			return;
		}
		var registerData = new Users
		{
			Name = Name,
			Email = Email,
			MobileNumber = Mobile,
			Password = Password,
			ConfirmPassword = ConfirmPassword
		};
		try
		{
			var response = await httpClient.PostAsJsonAsync("http://localhost:5266/api/Users/AddNewUserByUser", registerData);
			
			if (response.IsSuccessStatusCode)
			{
				status = "Yes";
			}
			else
			{
				// Handle registration failure
				await jS.InvokeVoidAsync("alert", "Registration failed. Please try again.");
			}
		}
		catch (Exception ex)
		{
			// Handle exceptions
			await jS.InvokeVoidAsync("alert", $"An error occurred: {ex.Message}");
		}
    }
}
