@page "/useranage"
@using BlazorApp.Components.Layout
@using BlazorApp.Model
@using Radzen
@using Radzen.Blazor.Rendering
@layout AdminRazorLayout
@inject HttpClient httpClient
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container-fluid">
    <div class="row">
        <div class="col-md-10 ms-sm-auto px-md-4 tab-content pt-3">
            <div class="tab-pane fade show active">
                <h2>User Manager</h2>

                @if (!dataload)
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 200px;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="ms-2 fs-5">Loading, please wait...</span>
                    </div>
                }
                else
                {
                    <RadzenButton Text="Add User" Icon="add_circle" Style="margin-bottom:10px"
                                  Click="@InsertUser" />

                    <RadzenDataGrid TItem="Users" Data="UserList" @ref="grid"
                                    AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="6"
                                    EditMode="DataGridEditMode.Single"
                                    RowCreate="@(args => AddUser(args))"
                                    RowUpdate="@(args => UpdateUser(args))">

                        <Columns>
                            <RadzenDataGridColumn TItem="Users" Property="Id" Title="Id" />

                            <RadzenDataGridColumn TItem="Users" Property="Name" Title="Name">
                                <EditTemplate Context="user">
                                    <RadzenTextBox @bind-Value="user.Name" Style="width:100%" />
                                </EditTemplate>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Users" Property="Email" Title="Email">
                                <EditTemplate Context="user">
                                    <RadzenTextBox @bind-Value="user.Email" Style="width:100%" />
                                </EditTemplate>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Users" Property="MobileNumber" Title="Mobile">
                                <EditTemplate Context="user">
                                    <RadzenTextBox @bind-Value="user.MobileNumber" Style="width:100%" />
                                </EditTemplate>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Users" Title="Role">
                                <EditTemplate Context="user">
                                    <RadzenDropDown @bind-Value="user.RoleId" Data="RoleList"
                                                    TextProperty="Roles" ValueProperty="Id" Style="width:100%" />
                                </EditTemplate>
                                <Template Context="D">
                                    @D.Role?.Roles
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Users" Context="user" Title="Actions">
                                <Template Context="user">
                                    <RadzenButton Icon="edit" Click="@(args => grid.EditRow(user))"
                                                  Style="margin-right:5px" />
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                                  Click="@(args => DeleteUser(user))" Style="margin-right:5px" />
                                </Template>
                                <EditTemplate Context="user">
                                    <RadzenButton Icon="save" Click="@(args => grid.UpdateRow(user))"
                                                  Style="margin-right:5px" />
                                    <RadzenButton Icon="cancel" Click="@(args => grid.CancelEditRow(user))" />
                                </EditTemplate>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Users> UserList = new List<Users>();
    private List<Role> RoleList = new List<Role>();
    private bool dataload = false;
    RadzenDataGrid<Users> grid;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var userdata = await httpClient.GetFromJsonAsync<ApiResponse<List<Users>>>("http://localhost:5266/api/Users");
            var Roledata = await httpClient.GetFromJsonAsync<ApiResponse<List<Role>>>("http://localhost:5266/api/Role");

            if (userdata != null && userdata.Value != null)
            {
                UserList = userdata.Value;
            }

            if (Roledata != null && Roledata.Value != null)
            {
                RoleList = Roledata.Value;
            }

            dataload = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void InsertUser()
    {
        var newUser = new Users
        {
            Name = "",
            Email = "",
            MobileNumber = "",
            RoleId = RoleList.FirstOrDefault()?.RoleId ?? 1
        };
        UserList.Insert(0, newUser);
        grid.EditRow(newUser);
    }

    private async Task AddUser(Users user)
    {
        try
        {
            var response = await httpClient.PostAsJsonAsync("http://localhost:5266/api/Users/AddUser", user);

            if (response.IsSuccessStatusCode)
            {
                await LoadData(); // Refresh the data
                grid.CancelEditRow(user);
            }
            else
            {
                await JS.InvokeVoidAsync("console.error", "Add failed");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task UpdateUser(Users user)
    {
        try
        {
            var response = await httpClient.PutAsJsonAsync($"http://localhost:5266/api/Users/UpdateUser/{user.Id}", user);

            if (response.IsSuccessStatusCode)
            {
                await LoadData(); // Refresh the data
            }
            else
            {
                await JS.InvokeVoidAsync("console.error", "Update failed");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task DeleteUser(Users user)
    {
        try
        {
            var response = await httpClient.DeleteAsync($"http://localhost:5266/api/Users/DeleteUser/{user.Id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadData(); // Refresh the data
            }
            else
            {
                await JS.InvokeVoidAsync("console.error", "Delete failed");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }
}