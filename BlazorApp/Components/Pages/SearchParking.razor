@page "/SearchParking"
@using BlazorApp.Model

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation



@* <h3>Location id : @LocationId</h3> *@
<h3>@(LocationId is null ? "Loading..." : $"Location id : {LocationId}")</h3>
<button type="button" @onclick="TestLog">Test Log</button>
@code {
    private string LocationId;
    private async Task TestLog()
    {
        Console.WriteLine("Button clicked");
        await JS.InvokeVoidAsync("console.log", "Button clicked");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            try
            {
                LocationId = await JS.InvokeAsync<string>("getSessionValue", "Search_Location");
                Console.WriteLine("Blazor (Output window) LocationId: " + LocationId);
                await JS.InvokeVoidAsync("console.log", "Browser console LocationId: " + LocationId);

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine("JS call failed: " + ex.Message);
            }

            StateHasChanged();
        }
    }
}


