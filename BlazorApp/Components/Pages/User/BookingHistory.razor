@page "/bookinghistroty"
@using BlazorApp.Components.Layout
@using BlazorApp.Model
@inject IJSRuntime JS
@inject HttpClient httpClient
@layout UserRazorLayout
@rendermode InteractiveServer


<main>
    <div class="container-fluid">
        <div class="row">


            <div class="col-md-10 ms-sm-auto px-md-4 tab-content pt-3">

                <div class="tab-pane fade show active" id="book-slot" role="tabpanel">
                    <h3 class="mb-5">BookingHistory</h3>


                    @if (!DataLoad)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2 fs-5">Loading, please wait...</span>
                        </div>
                    }
                    else
                    {
                      <RadzenDataGrid TItem="Booking" Data="BookingHistoryList" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="8">
                          <Columns>
                                <RadzenDataGridColumn TItem="Booking" Property="BookingId" Title="ID" Width="70px" />
                                <RadzenDataGridColumn TItem="Booking" Title="Location" ><Template Context="D"> @D.ParkingLocation?.Name</Template></RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="Booking" Title="Number" Width="120px"><Template Context="D"> @D.ParkingSlot?.SlotNumber</Template></RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="Booking" Title="Type" Width="100px"><Template Context="D"> @D.ParkingSlot?.SlotType</Template></RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="Booking" Property="StartTime" Title="StartTime" />
                                <RadzenDataGridColumn TItem="Booking" Property="ExitTime" Title="EndTime" />
                                <RadzenDataGridColumn TItem="Booking" Property="Status" Title="Status" Width="150px" />
                          </Columns>
                      </RadzenDataGrid>
                      
                    }
                   
                </div>
            </div>
        </div>
    </div>


</main>



@code {

    private List<Booking> BookingHistoryList = new();
    private bool DataLoad = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string id = await JS.InvokeAsync<string>("getSessionValue", "userId");
            var data = await httpClient.GetFromJsonAsync<ApiResponse<List<Booking>>>("http://localhost:5266/api/Booking/AllBooking");

            if (data != null)
            {
                BookingHistoryList = data.Value.Where(x => x.UserId == Convert.ToInt32(id)).ToList();
                DataLoad = true;
                StateHasChanged();
            }

            await JS.InvokeVoidAsync("console.log", BookingHistoryList);
        }
        
    }

}