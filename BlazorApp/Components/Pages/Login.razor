@page "/Login"
@rendermode InteractiveServer
@inject HttpClient httpClient
@inject IJSRuntime jS


<div class="d-flex flex-column justify-content-center justify-content-center vh-90 gap-3 " style="margin:30px 0 50px 0;">



    <form style="width: 450px; padding: 2%; background-color: white; border-radius: 3%;" class="container border border-success" id="LoginForm" @onsubmit="OnButton">

        <h3>  SPMS!! Login Your Account</h3>
        <br />

        <div class="mt-3">
            <label class="mb-1" for="">Email Address</label>
            <input @bind="Email" type="email" placeholder="Email Address" class="form-control">
            <span class="text-danger"></span>
        </div>
        <div class="mt-3">
            <label class="mb-1" for="">Password</label>
            <input @bind="Password" type="password" autocomplete="username" placeholder="Enter Password" class="form-control" id="LoginPassword">
            <span class="text-danger"></span>
        </div>

        <div class="form-check mt-3">
            <label class="form-check-label">
                <input @bind="rememberMe" class="form-check-input" type="checkbox" name="remember"> Remember me
            </label>
        </div>



        <button  type="submit" class="btn btn-primary mt-3 " style="width: 100%; ">SIGN IN</button>

    </form>
    <div class="container border border-success " style="width: 450px;  padding: 1%; background-color: white; border-radius: 5px;">
        <span>Don't have an account? </span><a href="/register" class="text-primary" style="text-decoration: none; font-weight:700 ;">Sign up</a>

    </div>

    
</div>
<h4>@LoginStatus</h4>
@if (LoginStatus != "Not")
{
    
<a href="/userDashboard" class="btn btn-outline-secondary btn-lg">User Dashboard</a>
    <a href="/admindashboard" class="btn btn-outline-secondary btn-lg">Admin Dashboard</a>
}
@code {

    public class LoginData
    {
        public string Email { get; set; }
        public string Password { get; set; }
    }

    public class LoginResponse
    {
        public string? Token { get; set; }
        public string? Username { get; set; }
        public string? Message { get; set; }
        public bool IsSuccess { get; set; }
        public string? Role { get; set; }
        public int? userID { get; set; }
    }


    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool rememberMe { get; set; } = false;

    private string EmailValidationMessage { get; set; } = string.Empty;
    private string PasswordValidationMessage { get; set; } = string.Empty;

    private string LoginStatus = "Not";

    private async Task OnButton()
    {
        EmailValidationMessage = string.Empty;
        PasswordValidationMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            EmailValidationMessage = "Email and Password are required.";

        }
        else if (!IsValidEmail(Email))
        {
            EmailValidationMessage = "Please enter a valid email.";
        }

        var loginData = new LoginData
        {
            Email = Email,
            Password = Password
        };

        await LoginRequest(loginData);
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }


    private async Task LoginRequest(LoginData loginData)
    {
        var response = await httpClient.PostAsJsonAsync("http://localhost:5266/api/UserAuthentication/UserLogin", loginData);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            LoginStatus = result?.Message ?? "Login Succeeded";
            await jS.InvokeVoidAsync("console.log", $"Message: {result?.Message}");
            await jS.InvokeVoidAsync("console.log", $"Token: {result?.Token}");
            await jS.InvokeVoidAsync("console.log", $"Role: {result?.Role}");
            await jS.InvokeVoidAsync("console.log", $"Success: {result?.IsSuccess}");
            await jS.InvokeVoidAsync("console.log", $"Name: {result?.Username}");
            await jS.InvokeVoidAsync("console.log", $"UserId: {result?.userID}");

            await jS.InvokeVoidAsync("sessionStorage.setItem", "Token", result?.Token);
            await jS.InvokeVoidAsync("sessionStorage.setItem", "Role", result?.Role);
            await jS.InvokeVoidAsync("sessionStorage.setItem", "Name", result?.Username);
            await jS.InvokeVoidAsync("sessionStorage.setItem", "userId", result?.userID);
            await jS.InvokeVoidAsync("eval", "console.log(sessionStorage)");
        }

    }


}
